{
  "name": "@chatondearu/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check:migrations": "tsx scripts/check-migrations-structure.ts",
    "db:seed:dev": "tsx src/seed/dev.ts",
    "db:import:sql": "tsx scripts/import-firestore.ts",
    "db:link:legacy-auth": "tsx scripts/link-legacy-profiles-auth.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@chatondearu/eslint-config": "workspace:*",
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.21.0",
    "typescript": "5.8.3"
  }
}
