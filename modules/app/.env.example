# Database / Auth (server-side only)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatondearu
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Optional comma-separated extra origins for Better Auth CSRF checks (prod hosts).
# BETTER_AUTH_URL and NUXT_PUBLIC_SITE_URL are always trusted when set.
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.chatondearu.fr,https://chatondearu.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Canonical site URL (French domain); used by redirects and SEO.
NUXT_PUBLIC_SITE_URL=https://chatondearu.fr

# Optional: extra hostnames permanently redirect → site URL with /en when needed.
NUXT_PUBLIC_REDIRECT_HOSTS_EN=

NUXT_PUBLIC_ME_HOST=

# Career CV — server-only (NOT NUXT_PUBLIC_*). Served via /api/career/contact after grant.
NUXT_CAREER_FULL_NAME=
NUXT_CAREER_EMAIL=
NUXT_CAREER_PHONE=
NUXT_CAREER_LOCATION=
# Comma-separated unlock tokens (query ?cv_token= or redeem form). Community login ≠ grant.
NUXT_CAREER_ACCESS_TOKENS=
# Comma-separated auth emails or user ids allowed to view CV (in addition to token grant).
NUXT_CAREER_ALLOWLIST=
# Optional HMAC secret for the CV grant cookie (defaults to BETTER_AUTH_SECRET).
# NUXT_CAREER_ACCESS_SECRET=

NUXT_PUBLIC_UMAMI_SCRIPT_URL=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
